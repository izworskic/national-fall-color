{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/national-tools/fall-color/blue-ridge-parkway",
      "destination": "/national-tools/fall-color/blue-ridge-parkway/index.html"
    },
    {
      "source": "/national-tools/fall-color/blue-ridge-parkway/",
      "destination": "/national-tools/fall-color/blue-ridge-parkway/index.html"
    }
  ],
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public"
}
